PORT=5000
JWT_SECRET=change_me_to_a_long_random_string
CORS_ORIGIN=*
# REQUIRED in production — the server REFUSES to boot without ADMIN_PASSWORD.
# In development it falls back to "admin123" with a warning.
ADMIN_PASSWORD=change_me_to_a_secure_password

# ---- Billing / trial configuration ----
# Free trial days per account type (server-side; values shown in every
# frontend banner/price text come from the live /api/subscription/status,
# never hard-coded in the app).
TRIAL_DAYS_CLUB=7
TRIAL_DAYS_GAMER=2
# Grace period (days) after a failed monthly renewal before access is disabled
PAYMENT_GRACE_DAYS=3
# Monthly prices (EGP)
PRICE_GAMER=39
PRICE_CLUB=299
CURRENCY=EGP

# ---- Kashier online payment gateway (test: "test", live: "live") ----
# Get these from the Kashier merchant portal (Integrate Now > Payment API Keys)
# plus the Merchant ID (MID) shown in your store settings.
KASHIER_MODE=test
KASHIER_API_KEY=
KASHIER_SECRET_KEY=
KASHIER_MERCHANT_ID=
KASHIER_CURRENCY=EGP
# Payment-provider webhook secret (HMAC-SHA256). Empty = webhook disabled;
# the manual admin-verification path is used instead.
WEBHOOK_SECRET=

# ---- Declaration vault passphrase ----
# 3 words joined by :: (used for AES-256-GCM encryption of player declarations).
# REQUIRED in production — the server REFUSES to boot without it (same policy
# as JWT_SECRET). The hardcoded fallback only works in development.
# Example: VAULT_PASSPHRASE=word1::word2::word3
VAULT_PASSPHRASE=K7#dM_Ocean_Plnet*94_Flcon^zR::X2$vT_Trndo_Spon%12_Bckt#mL::W9&qL_Jngle_Mrkr@83_Plnt!xP

# ---- Cloudinary video storage ----
# Configure Cloudinary on the backend only. Never commit real secrets.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# ---- Manara AI Assistant (OpenAI-compatible) ----
# Get a key at https://platform.openai.com/api-keys -- NEVER commit a real key.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Max length (chars) for a single assistant message
AI_MAX_MESSAGE_LENGTH=2000
